# ─────────────────────────────────────────────────────────────────────────
# Porte d'accès historique (utilisée UNIQUEMENT si l'auth Notion ci-dessous
# n'est pas configurée). Dissuasion côté client seulement.
VITE_ACCESS_PASSWORD=changez-moi

# ─────────────────────────────────────────────────────────────────────────
# Auth par email + code (à définir dans Vercel → Settings → Environment
# Variables). Dès que NOTION_TOKEN ET AUTH_SECRET sont présents, le login OTP
# s'active et remplace la porte mot de passe.

# Intégration interne Notion (à PARTAGER avec les bases Documents, Users, Logs).
NOTION_TOKEN=secret_xxx

# Bases de données Notion (valeurs par défaut déjà câblées si non définies).
NOTION_USERS_DB_ID=388bad056a95805eab75da1d1daed18c
NOTION_LOGS_DB_ID=388bad056a958067821add03dc25c056

# Secret aléatoire pour signer les codes OTP et les sessions (32+ caractères).
AUTH_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Envoi des emails — Option 1 : Gmail / Google Workspace (recommandé).
# Active la validation en 2 étapes puis génère un « mot de passe d'application ».
GMAIL_USER=theo@gouman.fr
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Envoi des emails — Option 2 : Resend (si RESEND_API_KEY est défini, prioritaire).
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Dataroom <noreply@votre-domaine.fr>
